{
  "$description": "Taala design tokens v1. Primitives are raw values; semantic tokens alias primitives. Screens use semantic tokens only. One mode (Figma Starter); dark mode out of scope (ADR-003).",
  "primitive": {
    "color": {
      "indigo": { "950": "#14123A", "900": "#1F1B5C", "800": "#2A2580", "700": "#3830A6", "600": "#4B43C7", "500": "#6A63DB", "300": "#A9A5EE", "100": "#E6E5FB", "50": "#F4F3FD" },
      "saffron": { "700": "#A84F00", "500": "#F08A1C", "300": "#F8C27F", "100": "#FDEBD3" },
      "mint": { "700": "#0B6B4A", "600": "#12855C", "500": "#2BB487", "100": "#DDF5EC" },
      "amber": { "800": "#8A4B00", "600": "#B06A00", "100": "#FFF0D9" },
      "red": { "800": "#A3201A", "600": "#D92D20", "100": "#FDE4E1" },
      "neutral": { "950": "#16161D", "800": "#2E2E3A", "700": "#3D3D4A", "600": "#55556A", "500": "#6F6F7D", "400": "#8A8A99", "300": "#C9C9D3", "200": "#E4E4EA", "100": "#F2F2F6", "0": "#FFFFFF" }
    },
    "space": { "0": 0, "1": 4, "2": 8, "3": 12, "4": 16, "5": 20, "6": 24, "8": 32, "10": 40, "12": 48, "16": 64 },
    "radius": { "sm": 8, "md": 12, "lg": 16, "xl": 24, "full": 999 },
    "font": {
      "family": { "latin": "Inter", "devanagari": "Noto Sans Devanagari", "kannada": "Noto Sans Kannada" },
      "size": { "xs": 12, "sm": 14, "md": 16, "lg": 18, "xl": 22, "2xl": 28, "3xl": 36, "4xl": 48 },
      "weight": { "regular": 400, "medium": 500, "semibold": 600, "bold": 700 },
      "lineHeight": { "latin": 1.4, "indic": 1.6 }
    },
    "elevation": {
      "0": "none",
      "1": "0 1 2 rgba(20,18,58,0.08)",
      "2": "0 4 12 rgba(20,18,58,0.12)",
      "3": "0 -8 24 rgba(20,18,58,0.16)"
    },
    "motion": { "instant": 100, "fast": 200, "base": 300, "slow": 450, "easing": "cubic-bezier(0.2, 0, 0, 1)" }
  },
  "semantic": {
    "color": {
      "bg/canvas": "{neutral.100}",
      "bg/surface": "{neutral.0}",
      "bg/brand": "{indigo.900}",
      "bg/brand-deep": "{indigo.950}",
      "bg/brand-subtle": "{indigo.50}",
      "text/primary": "{neutral.950}",
      "text/secondary": "{neutral.600}",
      "text/on-brand": "{neutral.0}",
      "text/brand": "{indigo.700}",
      "text/accent": "{saffron.700}",
      "border/default": "{neutral.200}",
      "border/strong": "{neutral.400}",
      "border/focus": "{indigo.600}",
      "action/primary": "{indigo.700}",
      "action/primary-pressed": "{indigo.800}",
      "action/secondary": "{indigo.100}",
      "accent/attention": "{saffron.500}",
      "feedback/success": "{mint.700}",
      "feedback/success-bg": "{mint.100}",
      "feedback/error": "{red.800}",
      "feedback/error-bg": "{red.100}",
      "risk/low": "{mint.600}",       "risk/low-text": "{mint.700}",   "risk/low-bg": "{mint.100}",
      "risk/medium": "{amber.600}",   "risk/medium-text": "{amber.800}","risk/medium-bg": "{amber.100}",
      "risk/high": "{red.600}",       "risk/high-text": "{red.800}",   "risk/high-bg": "{red.100}",
      "risk/blocked": "{neutral.700}","risk/blocked-text": "{neutral.800}","risk/blocked-bg": "{neutral.200}"
    },
    "contrast": {
      "text/primary on bg/surface": 18.0,
      "text/secondary on bg/surface": 7.26,
      "text/on-brand on action/primary": 9.81,
      "text/on-brand on bg/brand": 15.33,
      "text/accent on bg/surface": 5.55,
      "risk/low-text on risk/low-bg": 5.7,
      "risk/medium-text on risk/medium-bg": 6.06,
      "risk/high-text on risk/high-bg": 6.25,
      "risk/blocked-text on risk/blocked-bg": 10.58,
      "risk/low graphic on white": 4.63,
      "risk/medium graphic on white": 4.28,
      "risk/high graphic on white": 4.83,
      "border/strong on white": 3.4
    },
    "risk-redundancy": {
      "low": { "icon": "lock-closed", "segments": 1, "label": "Low" },
      "medium": { "icon": "lock-with-dot", "segments": 2, "label": "Medium" },
      "high": { "icon": "lock-with-shield", "segments": 3, "label": "High" },
      "blocked": { "icon": "lock-crossed", "segments": 4, "label": "Paused" }
    },
    "size": { "target/min": 48, "sheet/handle": 4, "pin/key": 64, "otp/box": 48 }
  }
}
